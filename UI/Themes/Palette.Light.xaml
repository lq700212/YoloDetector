<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        玻璃拟态主题 · 浅色调色板（Galaxy/Aurora 浅色版，与 design/风格提案.html 方案三一致）
        - 与 Palette.Dark.xaml 同名 key、同结构：运行时原位替换即可整体换肤，
          控件样式（GalaxyTheme.xaml）零改动。
        - 视频画面元素（Video*）与深色版完全相同：视频区永远压深色画面，恒定配色。
    -->

    <!-- 窗口背景：雾蓝→粉紫→薄荷 140° 渐变 -->
    <LinearGradientBrush x:Key="BgGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF0FF" Offset="0"/>
        <GradientStop Color="#F6EFFF" Offset="0.5"/>
        <GradientStop Color="#E6F7F3" Offset="1"/>
    </LinearGradientBrush>
    <!-- 背景光斑（浅色下为柔和马卡龙色；中段渐变站让衰减放缓，与深色版同参数） -->
    <RadialGradientBrush x:Key="Blob1Brush">
        <GradientStop Color="#8CB9A8FF" Offset="0"/>
        <GradientStop Color="#40B9A8FF" Offset="0.45"/>
        <GradientStop Color="#00B9A8FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob2Brush">
        <GradientStop Color="#8C7DE3D3" Offset="0"/>
        <GradientStop Color="#407DE3D3" Offset="0.45"/>
        <GradientStop Color="#007DE3D3" Offset="1"/>
    </RadialGradientBrush>

    <!-- 玻璃卡片：白色半透明（磨砂白）+ 白描边 -->
    <SolidColorBrush x:Key="GlassBrush" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#D9FFFFFF"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2438"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="#5F6A85"/>
    <SolidColorBrush x:Key="TextPhBrush" Color="#A5AEC5"/>

    <!-- 主色 / 语义色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5468F5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4054E8"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#4D5468F5"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#23A97C"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#2CBF8E"/>
    <SolidColorBrush x:Key="OnSuccessBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessGlowBrush" Color="#4D23A97C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E85C71"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#ED7A8B"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerGlowBrush" Color="#4DE85C71"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#E8890C"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82C4"/>

    <!-- 次级按钮（ghost）与输入框 -->
    <SolidColorBrush x:Key="GhostBgBrush" Color="#0F1E2438"/>
    <SolidColorBrush x:Key="GhostBorderBrush" Color="#1F1E2438"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1F1E2438"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#261E2438"/>

    <!-- 状态徽标（已连接） -->
    <SolidColorBrush x:Key="BadgeOkBgBrush" Color="#1F23A97C"/>
    <SolidColorBrush x:Key="BadgeOkTextBrush" Color="#1B7A58"/>
    <SolidColorBrush x:Key="BadgeOkBorderBrush" Color="#4D23A97C"/>

    <!-- 日志区 -->
    <SolidColorBrush x:Key="LogTextBrush" Color="#5F6A85"/>
    <SolidColorBrush x:Key="LogTimeBrush" Color="#9AA3B8"/>

    <!-- 视频画面元素：恒定深色（与深色版一致，不随主题翻转） -->
    <SolidColorBrush x:Key="VideoCardBgBrush" Color="#A80A0C10"/>
    <SolidColorBrush x:Key="VideoOverlayBrush" Color="#A80A0C10"/>
    <SolidColorBrush x:Key="VideoBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="VideoBadgeBgBrush" Color="#B80A0C10"/>
    <SolidColorBrush x:Key="VideoBadgeTextBrush" Color="#CFD6E0"/>
    <SolidColorBrush x:Key="VideoHintBrush" Color="#3D4552"/>
    <SolidColorBrush x:Key="VideoGhostBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="VideoGhostTextBrush" Color="#E8ECF1"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#331E2438"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#551E2438"/>
</ResourceDictionary>
