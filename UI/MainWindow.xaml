<!--
    主窗口（玻璃拟态 Glass Aurora 版，样式与布局翻译自 design/风格提案.html 方案三）。

    ASCII 布局图（AI 无法看图，改布局全靠这段文本图）：
    ┌──────────────────────────────────────────────────────────────────────────────┐
    │ 顶栏玻璃条 h=62                                                               │
    │  [■logo YOLO 玻璃台] [txtIp 相机IP] [btnConnect ⏻连接相机]                    │
    │                      [txtStreamUrl 流地址....flex....] [通道 -0+] [●徽标] [◐] │
    ├──────────────┬───────────────────────────────────────────────────────────────┤
    │ 左栏 274px    │ 视频玻璃卡（flex）                                             │
    │ ┌──────────┐ │  ┌─────────────────────────────────────────────────────┐      │
    │ │预览与流操作│ │  │ roiImage(RoiSelectionImage)                         │      │
    │ │[▶开始预览]│ │  │   左上角: lblStreamBadge(rtsp地址)  右上角: lblFpsBadge│      │
    │ │[■停止预览]│ │  │   居中: lblVideoTitle 占位提示（预览时隐藏）           │      │
    │ │[⇊开启拉流]│ │  │   右下浮层: [btnCalibTarget 标定][btnDoorBaseline 门基准]│   │
    │ │[⇈开启推流]│ │  └─────────────────────────────────────────────────────┘      │
    │ └──────────┘ │───────────────────────────────────────────────────────────────│
    │ ┌──────────┐ │ 日志玻璃卡 h=158                                              │
    │ │设备状态   │ │  [▎运行日志]                                                  │
    │ │(等宽文本) │ │  txtLog(只读等宽, 500行裁剪, 底部跟随滚动)                     │
    │ │flex 填充  │ │                                                              │
    │ └──────────┘ │                                                              │
    └──────────────┴───────────────────────────────────────────────────────────────┘

    交互接线（事件处理器在 MainWindow.xaml.cs，行为照搬 WinForms 版 MainForm.cs）：
      btnConnect    连接/断开相机（IP 校验、三态文案）
      btnStartPreview / btnStopPreview   启停 YOLO 预览检测链路
      btnStartRtsp / btnStartRtmp        相机拉流/推流（推流地址取 txtStreamUrl 文本）
      btnChannelUp / btnChannelDown      通道号步进（0 ~ Stream.MaxChannel）
      btnCalibTarget  切换拖拽标定目标（静电杆 ↔ 门区域）
      btnDoorBaseline 重设关门基准（用最近一帧预览画面）
      btnTheme        深色/浅色主题切换（Palette.Dark/Light 原位替换）
      roiImage.RoiSelected 归一化 ROI → 按 _calibTarget 分发热更新 + 配置落盘
-->
<Window x:Class="YoloDetector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YoloDetector.UI"
        Title="YOLO 实时人员检测系统"
        Width="1280" Height="800" MinWidth="1160" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgGradientBrush}"
        FontFamily="Bahnschrift, Microsoft YaHei"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid>
        <!-- 背景光斑（两个大椭圆 Radial 渐变，等效设计稿 CSS blur(90px) 光斑；
             静态渲染一次，不参与命中测试） -->
        <Ellipse Width="540" Height="540" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-150,-170,0,0" Fill="{DynamicResource Blob1Brush}" IsHitTestVisible="False"/>
        <Ellipse Width="580" Height="580" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-170,-210" Fill="{DynamicResource Blob2Brush}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 顶栏玻璃条（照设计稿：logo/IP/流地址/通道/徽标/主题，无连接按钮） ==================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6C7BFF" Offset="0"/>
                                    <GradientStop Color="#4EE6A8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="YOLO 玻璃台" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 相机 IP 输入（连接按钮在左栏"相机"卡，与设计稿一致） -->
                    <TextBox x:Name="txtIp" Grid.Column="1" Width="176"
                             Margin="18,0,0,0" Style="{StaticResource GlassInput}"
                             Tag="如 192.168.0.15" VerticalAlignment="Center"
                             ToolTip="相机 IP 地址，输入后点左栏【连接相机】"/>

                    <!-- 流地址（flex 拉伸填满剩余宽度，可手动改，预览/推流取此处文本） -->
                    <TextBox x:Name="txtStreamUrl" Grid.Column="2"
                             Margin="18,0,0,0" Style="{StaticResource GlassInput}"
                             Tag="rtsp://ip:554/stream0" VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             ToolTip="流地址：连接成功后自动填充，可手动修改；推流时此处填 RTMP 地址"/>

                    <!-- 通道 stepper（顶栏一份，与左栏"通道与标定"卡的 stepper 同步；CSS .m-stepper） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="通道" Style="{StaticResource FieldLabelText}"
                                   VerticalAlignment="Center"/>
                        <Border Height="34" CornerRadius="999"
                                Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnChannelTopDown" Content="−" Width="30"
                                        Style="{StaticResource RoundIconButton}"
                                        Click="btnChannelDown_Click"/>
                                <TextBlock x:Name="txtChannelTop" Text="0" MinWidth="30"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button x:Name="btnChannelTopUp" Content="+" Width="30"
                                        Style="{StaticResource RoundIconButton}"
                                        Click="btnChannelUp_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 连接状态徽标（CSS .m-badge：胶囊 + 呼吸光点） -->
                    <Border x:Name="badgeStatus" Grid.Column="4"
                            Style="{StaticResource StatusBadge}" Margin="18,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="badgeDot" Width="7" Height="7"
                                     Fill="{DynamicResource DangerBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.4" Duration="0:0:1"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="lblStatus" Text="未连接" Margin="7,0,0,0"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSubBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 深色/浅色主题切换（右上角） -->
                    <Button x:Name="btnTheme" Grid.Column="5" Content="◐"
                            Style="{StaticResource RoundIconButton}" Width="30" Height="30"
                            VerticalAlignment="Center" Margin="14,0,0,0"
                            ToolTip="切换深色 / 浅色主题"
                            Click="btnTheme_Click"/>
                </Grid>
            </Border>

            <!-- ==================== 主体 ==================== -->
            <Grid Grid.Row="1" Margin="22,16,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="274"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 左栏（照设计稿三卡：相机 / 通道与标定 / 设备状态） ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 卡1：相机（连接/断开主按钮 + 预览操作 2×2） -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="相机" Style="{StaticResource CardTitleText}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <!-- 连接/断开（三态文案：连接相机 → 连接中... → 断开连接） -->
                            <Button x:Name="btnConnect" Content="⏻ 连接相机"
                                    Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                    HorizontalAlignment="Stretch" Click="btnConnect_Click"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button x:Name="btnStartPreview" Content="▶ 开始预览"
                                        Style="{StaticResource SuccessButton}" Click="btnStartPreview_Click"
                                        ToolTip="启动 RTSP 拉流 + YOLO 实时检测（含静电杆/门监测）"/>
                                <Button x:Name="btnStopPreview" Content="■ 停止预览"
                                        Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                        Click="btnStopPreview_Click"/>
                                <Button x:Name="btnStartRtsp" Content="⇊ 开启拉流"
                                        Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                        Click="btnStartRtsp_Click"
                                        ToolTip="通知相机开启 RTSP 推流输出"/>
                                <Button x:Name="btnStartRtmp" Content="⇈ 开启推流"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="btnStartRtmp_Click"
                                        ToolTip="通知相机向流地址推流（RTMP）"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 卡2：通道与标定（通道 stepper + 标定切换/门基准，与视频浮层同步） -->
                    <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="通道与标定" Style="{StaticResource CardTitleText}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通道" Style="{StaticResource FieldLabelText}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="34" CornerRadius="999"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnChannelDown" Content="−" Width="30"
                                                Style="{StaticResource RoundIconButton}"
                                                Click="btnChannelDown_Click"/>
                                        <TextBlock x:Name="txtChannel" Text="0" MinWidth="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button x:Name="btnChannelUp" Content="+" Width="30"
                                                Style="{StaticResource RoundIconButton}"
                                                Click="btnChannelUp_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button x:Name="btnCalibTargetSide" Content="标定: 静电杆"
                                    Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                    HorizontalAlignment="Stretch" Click="btnCalibTarget_Click"
                                    ToolTip="切换拖拽框选的标定目标：静电杆区域 ↔ 门区域"/>
                            <Button x:Name="btnDoorBaselineSide" Content="重设门基准"
                                    Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Click="btnDoorBaseline_Click"
                                    ToolTip="门关着时点击：用最近一帧预览画面重新采集关门基准"/>
                        </StackPanel>
                    </Border>

                    <!-- 卡3：设备状态（等宽文本，flex 填满剩余高度） -->
                    <Border Grid.Row="4" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="设备状态" Style="{StaticResource CardTitleText}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="txtStatusInfo" Grid.Row="1"
                                       Style="{StaticResource StatusText}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="尚未连接相机&#x0a;&#x0a;连接后将显示：&#x0a;IP / 品牌&#x0a;CPU / 内存使用率&#x0a;磁盘总量与可用空间&#x0a;录像总数"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 右侧：视频 + 日志 ============ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="158"/>
                    </Grid.RowDefinitions>

                    <!-- 视频卡（深色底 + 玻璃描边，内容裁剪圆角） -->
                    <Border Grid.Row="0" Style="{StaticResource VideoCard}"
                            ClipToBounds="True">
                        <Grid>
                            <!-- 预览画面 + 拖拽框选（黄色虚线框在控件内绘制） -->
                            <local:RoiSelectionImage x:Name="roiImage" Stretch="Uniform"/>

                            <!-- 占位提示（预览启动隐藏、停止恢复） -->
                            <TextBlock x:Name="lblVideoTitle" Style="{StaticResource VideoHintText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="视频预览区域&#x0a;拖拽鼠标可框选标定区域"/>

                            <!-- 左上角：RTSP 地址徽标（预览启动才显示） -->
                            <Border x:Name="badgeStream" Style="{StaticResource VideoBadge}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="lblStreamBadge" Text=""
                                           FontSize="11" Foreground="{DynamicResource VideoBadgeTextBrush}"/>
                            </Border>

                            <!-- 右上角：通道徽标（预览启动才显示） -->
                            <Border x:Name="badgeChannel" Style="{StaticResource VideoBadge}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="lblChannelBadge" Text=""
                                           FontSize="11" Foreground="{DynamicResource VideoBadgeTextBrush}"/>
                            </Border>

                            <!-- 右下浮层：标定目标切换 + 重设门基准 -->
                            <Border Style="{StaticResource VideoFloatBar}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnCalibTarget" Content="标定: 静电杆"
                                            Style="{StaticResource VideoGhostButton}"
                                            Click="btnCalibTarget_Click"
                                            ToolTip="切换拖拽框选的标定目标：静电杆区域 ↔ 门区域"/>
                                    <Button x:Name="btnDoorBaseline" Content="重设门基准"
                                            Style="{StaticResource VideoSuccessButton}" Margin="8,0,0,0"
                                            Click="btnDoorBaseline_Click"
                                            ToolTip="门关着时点击：用最近一帧预览画面重新采集关门基准"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 日志玻璃卡 -->
                    <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="运行日志" Style="{StaticResource CardTitleText}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="txtLog" Grid.Row="1" Style="{StaticResource LogBox}"
                                     Foreground="{DynamicResource LogTextBrush}"
                                     SelectionBrush="{DynamicResource PrimaryBrush}"
                                     Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
