<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- App/SkBitmapExtensions 的整块内存拷贝使用 Buffer.MemoryCopy 指针重载 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- 检测模块已拆分为独立类库（Detection/YoloDetector.Detection.csproj），
       此处排除其源码避免重复编译，经项目引用使用 -->
  <ItemGroup>
    <Compile Remove="Detection\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Detection\YoloDetector.Detection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SunnyUI" Version="3.9.8" />
    <!-- OpenCvSharp/OnnxRuntime 已 vendor 到 Detection\libs（离线编译）；
         native 运行库经类库 csproj 的 None 项流转到本输出目录 -->
    <Reference Include="OpenCvSharp">
      <HintPath>Detection\libs\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.ML.OnnxRuntime">
      <HintPath>Detection\libs\Microsoft.ML.OnnxRuntime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>Detection\libs\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- net472 上使用 netstandard 依赖库所需的 Span/Memory 支撑程序集 -->
    <Reference Include="System.Memory"><HintPath>Detection\libs\System.Memory.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Buffers"><HintPath>Detection\libs\System.Buffers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>Detection\libs\System.Numerics.Vectors.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>Detection\libs\System.Runtime.CompilerServices.Unsafe.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- 防止默认通配把类库的构建中间产物当作内容项扫入 -->
  <ItemGroup>
    <None Remove="Detection\bin\**" />
    <None Remove="Detection\obj\**" />
  </ItemGroup>
  <!-- 配置文件复制：编译时自动复制到输出目录 -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- 品牌配置文件复制：仅复制 .json 文件 -->
  <ItemGroup>
    <Content Include="cameraConfigs\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- 检测模块配置与模型文件复制 -->
  <ItemGroup>
    <Content Include="Detection\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Detection\model\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
