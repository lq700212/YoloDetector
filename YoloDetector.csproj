<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <!-- v2.10 起界面层为 WPF（玻璃拟态主题），原 WinForms/SunnyUI 已整体移除；
         检测类库/相机/配置/App 编排层与 UI 框架无关，未受影响 -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- WPF 应用入口：App.xaml 作为 ApplicationDefinition（其余 .xaml 由 SDK 自动当 Page 编译） -->
  <ItemGroup>
    <ApplicationDefinition Include="UI\App.xaml" />
  </ItemGroup>
  <!-- 检测模块拆分（v2.11）：通用检测核心沉淀到 kaleidoscope 仓库（git submodule，
       Kaleidoscope.Detection.dll，命名空间仍为 YoloDetection）；本目录 Detection\ 只剩
       业务检测层类库（管道 + 静电触摸/门监测分析器）。两处源码都不进主程序编译，
       排除默认通配避免重复编译，经项目引用使用 -->
  <ItemGroup>
    <Compile Remove="Detection\**\*.cs" />
    <!-- submodule 内容必须整体排除：SDK 默认通配会把 kaleidoscope 内所有 .cs/
         bin/obj 扫进主项目（实测会与核心库 DLL 重复编译冲突）。v2.11.2 补 Page
         排除——Kaleidoscope.UI 控件库新增 .xaml 样式字典后，UseWPF 的默认通配
         还会把它们当 Page 扫进主项目 XAML 编译（实测 MC3074：主程序集里解析
         不到库内 clr-namespace 类型），四类排除缺一不可 -->
    <Compile Remove="submodules\**\*.cs" />
    <None Remove="submodules\**" />
    <Content Remove="submodules\**" />
    <Page Remove="submodules\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="submodules\kaleidoscope\Vision\Detection\Kaleidoscope.Detection.csproj" />
    <ProjectReference Include="Detection\YoloDetector.Detection.csproj" />
    <!-- Kaleidoscope.UI：公司级 WPF 复用控件库（v2.11.2 起 UI 层接入）——
         MainWindow 改继承其 ChromeBorderlessWindow（无边框圆角窗纯行为基类，
         零键板依赖，玻璃拟态视觉仍全部由宿主 XAML 自绘）。多目标库
         （net472;net8.0-windows）经 ProjectReference 自动选 net472 产物 -->
    <ProjectReference Include="submodules\kaleidoscope\Kaleidoscope.UI\Kaleidoscope.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 依赖 vendor（零 NuGet、克隆即编译，工厂无网环境可用）：
         OpenCvSharp/OnnxRuntime/SkiaSharp/System.* 统一指向 submodule 内 libs
         （与核心库共用同一份，防双处漂移）；Newtonsoft.Json 是宿主 App/Configuration
         层依赖（核心库不用），vendor 在主项目 libs\（SunnyUI 为 WinForms 遗留，
         v2.10 起 WPF 化后已移除） -->
    <Reference Include="Newtonsoft.Json"><HintPath>libs\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <!-- OpenCvSharp/OnnxRuntime 已 vendor 到 submodule libs（离线编译）；
         native 运行库经核心库 csproj 的 None 项流转到本输出目录 -->
    <Reference Include="OpenCvSharp">
      <HintPath>submodules\kaleidoscope\Vision\Detection\libs\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.ML.OnnxRuntime">
      <HintPath>submodules\kaleidoscope\Vision\Detection\libs\Microsoft.ML.OnnxRuntime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>submodules\kaleidoscope\Vision\Detection\libs\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- net472 上使用 netstandard 依赖库所需的 Span/Memory 支撑程序集 -->
    <Reference Include="System.Memory"><HintPath>submodules\kaleidoscope\Vision\Detection\libs\System.Memory.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Buffers"><HintPath>submodules\kaleidoscope\Vision\Detection\libs\System.Buffers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>submodules\kaleidoscope\Vision\Detection\libs\System.Numerics.Vectors.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>submodules\kaleidoscope\Vision\Detection\libs\System.Runtime.CompilerServices.Unsafe.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- 防止默认通配把类库的构建中间产物当作内容项扫入 -->
  <ItemGroup>
    <None Remove="Detection\bin\**" />
    <None Remove="Detection\obj\**" />
  </ItemGroup>
  <!-- 配置文件复制策略（v2.8 起）：运行配置属于现场资产——静电杆 ROI 标定、阈值、IP
       都由现场在输出目录上调整，重新构建不得重置（此前 PreserveNewest 会在源码版配置
       mtime 更新时覆盖 bin 里的现场标定，导致"重启后 ROI 标定失效"）。故改为：
       仅当输出目录不存在该文件时才复制（首次部署兜底），已存在则一律不动。
       模型文件（Detection\model\**）不在此列：保持 PreserveNewest，缺失时随构建补齐。
       注意 Dest 必须在静态 ItemGroup 里预计算——Target 内的 batching Include 不继承
       RecursiveDir 等通配元数据，会把 Detection\ 子目录丢掉（实测踩坑）。 -->
  <ItemGroup>
    <RuntimeConfigSource Include="appsettings.json">
      <Dest>$(OutDir)appsettings.json</Dest>
    </RuntimeConfigSource>
    <RuntimeConfigSource Include="Detection\*.json">
      <Dest>$(OutDir)Detection\%(Filename)%(Extension)</Dest>
    </RuntimeConfigSource>
    <RuntimeConfigSource Include="cameraConfigs\**\*.json">
      <Dest>$(OutDir)cameraConfigs\%(Filename)%(Extension)</Dest>
    </RuntimeConfigSource>
  </ItemGroup>
  <Target Name="CopyRuntimeConfigsIfMissing" AfterTargets="Build">
    <Copy SourceFiles="@(RuntimeConfigSource)"
          DestinationFiles="%(RuntimeConfigSource.Dest)"
          Condition="!Exists(%(RuntimeConfigSource.Dest))" />
  </Target>
  <!-- 品牌配置/检测配置的声明保留 VS 解决方案资源管理器可见性，但不参与自动复制 -->
  <ItemGroup>
    <Content Include="cameraConfigs\**\*.json" CopyToOutputDirectory="Never" />
    <Content Include="Detection\*.json" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <!-- 检测模块模型文件复制：缺失时随构建补齐（大二进制现场不改，覆盖无害） -->
  <ItemGroup>
    <Content Include="Detection\model\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
