<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- App/SkBitmapExtensions 的整块内存拷贝使用 Buffer.MemoryCopy 指针重载 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- 检测模块已拆分为独立类库（Detection/YoloDetector.Detection.csproj），
       此处排除其源码避免重复编译，经项目引用使用 -->
  <ItemGroup>
    <Compile Remove="Detection\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Detection\YoloDetector.Detection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 全部依赖均 vendor 到 Detection\libs（零 NuGet、克隆即编译，工厂无网环境可用）：
         SunnyUI/Newtonsoft.Json 原为 NuGet 包，已按 net472/net45 目标复制 DLL 进 libs，
         传递依赖链为空（SunnyUI→SunnyUI.Common，Newtonsoft.Json(net45) 无依赖） -->
    <Reference Include="SunnyUI"><HintPath>Detection\libs\SunnyUI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SunnyUI.Common"><HintPath>Detection\libs\SunnyUI.Common.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>Detection\libs\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <!-- OpenCvSharp/OnnxRuntime 已 vendor 到 Detection\libs（离线编译）；
         native 运行库经类库 csproj 的 None 项流转到本输出目录 -->
    <Reference Include="OpenCvSharp">
      <HintPath>Detection\libs\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.ML.OnnxRuntime">
      <HintPath>Detection\libs\Microsoft.ML.OnnxRuntime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>Detection\libs\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- net472 上使用 netstandard 依赖库所需的 Span/Memory 支撑程序集 -->
    <Reference Include="System.Memory"><HintPath>Detection\libs\System.Memory.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Buffers"><HintPath>Detection\libs\System.Buffers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>Detection\libs\System.Numerics.Vectors.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>Detection\libs\System.Runtime.CompilerServices.Unsafe.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- 防止默认通配把类库的构建中间产物当作内容项扫入 -->
  <ItemGroup>
    <None Remove="Detection\bin\**" />
    <None Remove="Detection\obj\**" />
  </ItemGroup>
  <!-- 配置文件复制策略（v2.8 起）：运行配置属于现场资产——静电杆 ROI 标定、阈值、IP
       都由现场在输出目录上调整，重新构建不得重置（此前 PreserveNewest 会在源码版配置
       mtime 更新时覆盖 bin 里的现场标定，导致"重启后 ROI 标定失效"）。故改为：
       仅当输出目录不存在该文件时才复制（首次部署兜底），已存在则一律不动。
       模型文件（Detection\model\**）不在此列：保持 PreserveNewest，缺失时随构建补齐。
       注意 Dest 必须在静态 ItemGroup 里预计算——Target 内的 batching Include 不继承
       RecursiveDir 等通配元数据，会把 Detection\ 子目录丢掉（实测踩坑）。 -->
  <ItemGroup>
    <RuntimeConfigSource Include="appsettings.json">
      <Dest>$(OutDir)appsettings.json</Dest>
    </RuntimeConfigSource>
    <RuntimeConfigSource Include="Detection\*.json">
      <Dest>$(OutDir)Detection\%(Filename)%(Extension)</Dest>
    </RuntimeConfigSource>
    <RuntimeConfigSource Include="cameraConfigs\**\*.json">
      <Dest>$(OutDir)cameraConfigs\%(Filename)%(Extension)</Dest>
    </RuntimeConfigSource>
  </ItemGroup>
  <Target Name="CopyRuntimeConfigsIfMissing" AfterTargets="Build">
    <Copy SourceFiles="@(RuntimeConfigSource)"
          DestinationFiles="%(RuntimeConfigSource.Dest)"
          Condition="!Exists(%(RuntimeConfigSource.Dest))" />
  </Target>
  <!-- 品牌配置/检测配置的声明保留 VS 解决方案资源管理器可见性，但不参与自动复制 -->
  <ItemGroup>
    <Content Include="cameraConfigs\**\*.json" CopyToOutputDirectory="Never" />
    <Content Include="Detection\*.json" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <!-- 检测模块模型文件复制：缺失时随构建补齐（大二进制现场不改，覆盖无害） -->
  <ItemGroup>
    <Content Include="Detection\model\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
