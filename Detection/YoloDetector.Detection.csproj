<Project Sdk="Microsoft.NET.Sdk">
  <!--
    YoloDetector 业务检测层类库（net472 宿主专用）：
    v2.11 起 YOLO 检测通用核心（检测器/帧源/接口/互转/可视化/ROI/日志）已沉淀到
    kaleidoscope 仓库（git submodule，Kaleidoscope.Detection.dll，命名空间仍为
    YoloDetection——同名命名空间跨程序集类型无缝解析，宿主代码零 using 改动），
    本程序集只保留与具体业务耦合的部分：
      - YoloDetectionService     检测管道实现（Monitor 生产者-消费者 + 单槽位缓冲，
                                 带静电触摸/门监测业务旁路；管道依赖业务分析器，
                                 故随业务层留在宿主）
      - EsdContactAnalyzer 等    静电杆触摸检测业务分析器（状态机 + 叠加绘制）
      - DoorMonitorAnalyzer 等   门状态监测业务分析器（基准比对 + 防抖 + 叠加绘制）
    依赖方向：本程序集 → Kaleidoscope.Detection（submodule 内核心库）。
    约束保持不变：禁止引用宿主业务命名空间之外的内容（UI/App/Cameras/
    Configuration 不反被本库引用）；日志经 LogManager（核心库）委托注入；
    ESD/门运行参数由调用方经 DTO 注入（本库不读配置文件）。
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <!-- 通用检测核心：kaleidoscope submodule 内的多目标类库（net472 目标在此被消费） -->
  <ItemGroup>
    <ProjectReference Include="..\submodules\kaleidoscope\Vision\Detection\Kaleidoscope.Detection.csproj" />
  </ItemGroup>
  <!-- OpenCvSharp：Esd/Door 叠加渲染器直接使用 Mat 绘制（HintPath 指向 submodule libs，
       与核心库共用同一份 vendor DLL，避免双处漂移） -->
  <ItemGroup>
    <Reference Include="OpenCvSharp">
      <HintPath>..\submodules\kaleidoscope\Vision\Detection\libs\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Span/Memory 支撑程序集：显式对齐核心库引用版本，消除 RAR 版本差异告警(MSB3276) -->
    <Reference Include="System.Memory"><HintPath>..\submodules\kaleidoscope\Vision\Detection\libs\System.Memory.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Buffers"><HintPath>..\submodules\kaleidoscope\Vision\Detection\libs\System.Buffers.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>..\submodules\kaleidoscope\Vision\Detection\libs\System.Numerics.Vectors.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>..\submodules\kaleidoscope\Vision\Detection\libs\System.Runtime.CompilerServices.Unsafe.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
